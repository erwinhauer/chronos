NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen nodig voor server-side beheeracties (gebruikers aanmaken, wachtwoorden zetten)
# en het changelog-script — nooit aan de client blootstellen.
SUPABASE_SERVICE_ROLE_KEY=

# Alleen nodig voor de deploy-pipeline (vercel-build): koppelt de Supabase CLI aan het
# project om schema-migraties automatisch te pushen bij elke deploy.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Tijdelijk, tot de echte Patricia-koppeling er is: HubSpot Private App-token
# (scope "crm.objects.companies.read") voor de "Importeer klanten uit HubSpot"-knop
# bij Instellingen. Aanmaken via HubSpot > Instellingen > Integraties > Private Apps.
HUBSPOT_ACCESS_TOKEN=

# Patricia-koppeling (read-only, zie patricia_fields.md): vult bij een nieuw
# factuuritem automatisch de dossiernaam en klant in op basis van het
# dossiernummer. Alleen bereikbaar vanaf het Knijff-netwerk/VPN — ontbreken
# deze variabelen (bv. lokaal zonder toegang, of op Vercel zonder tunnel) dan
# valt het gewoon terug op handmatige invoer, zonder foutmelding.
PATRICIA_DB_HOST=10.171.174.204
PATRICIA_DB_PORT=1433
PATRICIA_DB_NAME=Patricia
PATRICIA_DB_DOMAIN=knijff
PATRICIA_DB_USER=
PATRICIA_DB_PASSWORD=
